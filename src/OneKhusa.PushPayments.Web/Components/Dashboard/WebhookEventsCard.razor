@implements IDisposable
@inject WebhookLog Log
@inject IPaymentStore Store
@inject WebhookSimulator Simulator
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation

<div class="card">
    <h2><span class="dot orange"></span> Webhook Events</h2>

    <div class="btn-group" style="margin-bottom: 12px;">
        <button class="btn-secondary" @onclick="Refresh">Refresh</button>
        <button class="btn-secondary" @onclick="Log.Clear">Clear</button>
        @if (Environment.IsDevelopment())
        {
            <select class="btn-secondary" @bind="_testEvent" title="Event to simulate">
                @foreach (var eventName in PushPaymentEvents.All)
                {
                    <option value="@eventName">@eventName</option>
                }
            </select>
            <button class="btn-primary" @onclick="SendTestWebhookAsync" disabled="@_sending" style="font-size: 11px; padding: 6px 12px;">
                @_testButtonText
            </button>
        }
    </div>

    @if (_testError is not null)
    {
        <div class="result-box error" style="margin: 0 0 12px;">@_testError</div>
    }

    <div class="webhook-list">
        @if (_deliveries.Count == 0)
        {
            <div class="empty">No webhook events yet</div>
        }
        @foreach (var delivery in _deliveries)
        {
            <WebhookEventItem Delivery="delivery" />
        }
    </div>
</div>

@code {
    private const string DefaultTestButtonText = "Send Test Webhook";

    private IReadOnlyList<OneKhusa.Webhooks.Diagnostics.WebhookDelivery> _deliveries = [];
    private string _testEvent = PushPaymentEvents.Success;
    private string _testButtonText = DefaultTestButtonText;
    private string? _testError;
    private bool _sending;

    protected override void OnInitialized()
    {
        Refresh();
        Log.Changed += OnLogChanged;
    }

    private void Refresh() => _deliveries = Log.GetAll();

    private void OnLogChanged() => InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    /// <summary>
    /// Signs a sample payload with the configured secret and posts it to this app's own endpoint.
    /// Targets the most recent payment still waiting for the customer, so its status changes too.
    /// </summary>
    private async Task SendTestWebhookAsync()
    {
        _sending = true;
        _testError = null;
        _testButtonText = "Sending...";
        try
        {
            var payment = Store.GetAll().FirstOrDefault(p => p.Status == PaymentStatus.AwaitingCustomer)
                ?? Store.GetAll().FirstOrDefault();
            var body = Simulator.BuildSamplePayload(_testEvent, payment);
            var endpoint = new Uri(new Uri(Navigation.BaseUri), WebhookEndpointExtensions.DefaultPushPaymentPattern.TrimStart('/'));

            var result = await Simulator.SendAsync(endpoint, _testEvent, body, corruptSignature: false);
            _testError = result.Error;
            _testButtonText = result.Error is null ? "Sent!" : "Error";
        }
        finally
        {
            _sending = false;
        }

        StateHasChanged();
        await Task.Delay(2000);
        _testButtonText = DefaultTestButtonText;
    }

    public void Dispose() => Log.Changed -= OnLogChanged;
}
